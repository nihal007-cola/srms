// FIXED: Cancel BOM - Cancels entire FG with cascade
// ==============================================================

// Override the cancelStageAction function with full FG cancellation
// ==============================================================
// FIX: BOM Cancel - Override the render to use cancelFG
// ==============================================================

// Store original render function
const originalRenderBOMOrders = window.renderBOMOrders;

// Override renderBOMOrders to use cancelFG
window.renderBOMOrders = function(orders) {
    const tb = document.getElementById('bomOrderBody');
    if (!orders || orders.length === 0) {
        tb.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#62748e;padding:16px;">No pending orders</td></tr>';
        return;
    }
    let html = '';
    orders.forEach(o => {
        const date = o.orderDate ? new Date(o.orderDate).toLocaleDateString('en-IN') : '—';
        const reqStatus = o.requirementStatus || 'PENDING';
        const statusBadge = reqStatus === 'COMPLETED' ? 'success' : reqStatus === 'PENDING' ? 'warning' : 'info';
        const fgKey = o.fgKey || '—';
        
        // Check if already cancelled
        const isCancelled = o.bomStatus === 'CANCELLED' || o.requirementStatus === 'CANCELLED';
        
        html += `<tr>
            <td><strong>${fgKey}</strong></td>
            <td>${o.buyerOrderNo || '—'}</td>
            <td>${date}</td>
            <td>
                ${!isCancelled ? `
                <button class="btn btn-primary btn-sm" onclick="openBOMModal('${fgKey}')"><i class="fas fa-pencil-alt"></i> Assign RM</button>
                <button class="btn btn-danger btn-sm" onclick="cancelFG('${fgKey}')"><i class="fas fa-undo"></i> Cancel</button>
                ` : `
                <span class="badge-status danger">CANCELLED</span>
                `}
                <span class="badge-status ${statusBadge}">${reqStatus}</span>
            </td>
        </tr>`;
    });
    tb.innerHTML = html;
};

console.log('✅ BOM Cancel override loaded');
// ==============================================================
// REPLACE the cancelFG function in frontend/js/app.js
// With this version that shows proper workflow messages
// ==============================================================

async function cancelFG(fgKey) {
    // Check if it's a BOM cancellation (we're on BOM page)
    const bomRow = document.querySelector(`#bomOrderBody tr:has(td:contains("${fgKey}"))`);
    
    // First confirmation
    if (!confirm(`⚠️ Are you sure you want to CANCEL FG: ${fgKey}?\n\nThis will cancel the BOM for this FG.\n\nNote: Cancellation is only allowed if no downstream records exist.\n\nContinue?`)) {
        return;
    }
    
    // Second confirmation
    if (!confirm(`⚠️ FINAL CONFIRMATION: Cancel BOM for FG ${fgKey}?\n\nThis action cannot be undone.`)) {
        return;
    }
    
    showToast(`Checking FG ${fgKey} status...`, 'info');
    
    try {
        const response = await fetch('/utils/cancel/fg', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ fg_key: fgKey })
        });
        
        const result = await response.json();
        
        if (result.success) {
            showToast(`✅ BOM cancelled for FG ${fgKey}`, 'success');
            refreshBOMOrders();
            refreshRMOrders();
            refreshGRNOrders();
            refreshIssueRMOrders();
        } else if (result.blocked) {
            // Show blocked message with details
            const reasons = result.reason || ['Downstream records exist'];
            alert(`❌ CANCELLATION BLOCKED\n\nThis FG has already progressed beyond the BOM stage.\n\nBlocked because:\n- ${reasons.join('\n- ')}\n\nPlease reverse the workflow one stage before cancelling.`);
            showToast(`❌ Cannot cancel: ${result.message}`, 'error');
        } else {
            showToast(`❌ Error: ${result.message}`, 'error');
        }
    } catch (error) {
        console.error('Cancel FG error:', error);
        showToast(`❌ Error cancelling FG: ${error.message}`, 'error');
    }
}

