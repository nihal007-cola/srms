// ==============================================================
// FINAL FIX: Completely replace renderBOMOrders
// ==============================================================

// Remove any existing renderBOMOrders function and replace it
// This ensures the cancel button uses cancelFG

// First, delete the old function if it exists
if (typeof window.renderBOMOrders === 'function') {
    delete window.renderBOMOrders;
}

// Define the new function
window.renderBOMOrders = function(orders) {
    console.log('🔧 renderBOMOrders called with', orders ? orders.length : 0, 'orders');
    
    const tb = document.getElementById('bomOrderBody');
    if (!tb) {
        console.error('❌ bomOrderBody not found!');
        return;
    }
    
    if (!orders || orders.length === 0) {
        tb.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#62748e;padding:16px;">No pending orders</td></tr>';
        return;
    }
    
    let html = '';
    orders.forEach(o => {
        const date = o.orderDate ? new Date(o.orderDate).toLocaleDateString('en-IN') : '—';
        const reqStatus = o.requirementStatus || 'PENDING';
        const bomStatus = o.bomStatus || 'PENDING';
        const fgKey = o.fgKey || '—';
        
        // Check if cancelled
        const isCancelled = bomStatus === 'CANCELLED' || reqStatus === 'CANCELLED';
        
        let statusBadge = 'info';
        let statusText = reqStatus;
        if (isCancelled) {
            statusBadge = 'danger';
            statusText = 'CANCELLED';
        } else if (reqStatus === 'COMPLETED') {
            statusBadge = 'success';
        } else if (reqStatus === 'PENDING') {
            statusBadge = 'warning';
        }
        
        // Build actions - using cancelFG for the cancel button
        let actions = '';
        if (!isCancelled) {
            actions = `
                <button class="btn btn-primary btn-sm" onclick="openBOMModal('${fgKey}')"><i class="fas fa-pencil-alt"></i> Assign RM</button>
                <button class="btn btn-danger btn-sm" onclick="cancelFG('${fgKey}')"><i class="fas fa-undo"></i> Cancel</button>
            `;
        } else {
            actions = `<span class="badge-status danger">CANCELLED</span>`;
        }
        
        html += `<tr>
            <td><strong>${fgKey}</strong></td>
            <td>${o.buyerOrderNo || '—'}</td>
            <td>${date}</td>
            <td>
                ${actions}
                <span class="badge-status ${statusBadge}">${statusText}</span>
            </td>
        </tr>`;
    });
    
    tb.innerHTML = html;
    console.log('✅ BOM table rendered with', orders.length, 'rows');
};

// Also fix refreshBOMOrders to use the new render
window.refreshBOMOrders = async function() {
    console.log('🔄 Refreshing BOM orders...');
    showToast('Loading orders...', 'info');
    try {
        const orders = await API.getBOMOrders();
        console.log('📦 Received', orders ? orders.length : 0, 'BOM orders');
        window.renderBOMOrders(orders);
        showToast(orders && orders.length ? 'Orders loaded' : 'No pending orders', orders && orders.length ? 'success' : 'info');
    } catch (e) {
        console.error('❌ Error loading BOM orders:', e);
        showToast('Error: ' + e.message, 'error');
    }
};

