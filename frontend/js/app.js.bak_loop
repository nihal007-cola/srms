// ==============================================================
// TABLE FILTER FUNCTIONS
// ==============================================================

// BOM Table Filter
function filterBOMTable() {
    const rows = document.querySelectorAll('#bomOrderBody tr');
    const filters = document.querySelectorAll('#module-BOM .filter-input');
    
    rows.forEach(row => {
        let show = true;
        filters.forEach(filter => {
            const col = filter.dataset.col;
            const val = filter.value.toLowerCase().trim();
            if (!val) return;
            
            const cell = row.querySelector(`td:nth-child(${getColIndex(col)})`);
            if (cell) {
                const cellText = cell.textContent.toLowerCase().trim();
                if (!cellText.includes(val)) show = false;
            }
        });
        row.style.display = show ? '' : 'none';
    });
}

// RM Order Table Filter
function filterRMOrderTable() {
    const rows = document.querySelectorAll('#rmOrderBody tr');
    const filters = document.querySelectorAll('#module-RM_ORDER .filter-input');
    
    rows.forEach(row => {
        let show = true;
        filters.forEach(filter => {
            const col = filter.dataset.col;
            const val = filter.value.toLowerCase().trim();
            if (!val) return;
            
            const cell = row.querySelector(`td:nth-child(${getColIndex(col)})`);
            if (cell) {
                const cellText = cell.textContent.toLowerCase().trim();
                if (!cellText.includes(val)) show = false;
            }
        });
        row.style.display = show ? '' : 'none';
    });
}

// GRN Table Filter
function filterGRNTable() {
    const rows = document.querySelectorAll('#grnBody tr');
    const filters = document.querySelectorAll('#module-GRN .filter-input');
    
    rows.forEach(row => {
        let show = true;
        filters.forEach(filter => {
            const col = filter.dataset.col;
            const val = filter.value.toLowerCase().trim();
            if (!val) return;
            
            const cell = row.querySelector(`td:nth-child(${getColIndex(col)})`);
            if (cell) {
                const cellText = cell.textContent.toLowerCase().trim();
                if (!cellText.includes(val)) show = false;
            }
        });
        row.style.display = show ? '' : 'none';
    });
}

// Issue RM Table Filter
function filterIssueRMTable() {
    const rows = document.querySelectorAll('#issueRMOrderBody tr');
    const filters = document.querySelectorAll('#module-ISSUE_RM .filter-input');
    
    rows.forEach(row => {
        let show = true;
        filters.forEach(filter => {
            const col = filter.dataset.col;
            const val = filter.value.toLowerCase().trim();
            if (!val) return;
            
            const cell = row.querySelector(`td:nth-child(${getColIndex(col)})`);
            if (cell) {
                const cellText = cell.textContent.toLowerCase().trim();
                if (!cellText.includes(val)) show = false;
            }
        });
        row.style.display = show ? '' : 'none';
    });
}

// Helper to get column index based on data-col
function getColIndex(col) {
    const map = {
        'fgKey': 1,
        'buyerOrderNo': 2,
        'orderDate': 3,
        'supplier': 1,
        'fgKeys': 2,
        'totalQuantity': 3,
        'poToken': 2,
        'items': 5,
        'orderedQty': 6,
        'receivedQty': 7,
        'balanceQty': 8,
        'status': 9,
        'totalRequired': 2,
        'totalGRN': 3,
        'totalIssued': 4,
        'availableToIssue': 5
    };
    return map[col] || 1;
}

// Cancel RM Order (double confirmation)
async function cancelRMOrderAction() {
    const supplier = document.getElementById('poModalSupplier')?.textContent?.replace('Supplier: ', '').trim();
    if (!supplier) {
        showToast('No RM order to cancel', 'error');
        return;
    }
    
    if (!confirm(`⚠️ Are you sure you want to CANCEL RM ORDER for ${supplier}?`)) return;
    if (!confirm(`⚠️ FINAL CONFIRMATION: Cancel RM ORDER for ${supplier}? This cannot be undone!`)) return;
    
    showToast('Cancelling RM Order...', 'info');
    try {
        const supplierData = ERP_STATE.rmOrdersData.find(o => o.supplier === supplier);
        if (!supplierData) {
            showToast('Supplier not found', 'error');
            return;
        }
        const fgKeys = supplierData.fgKeys || [];
        if (fgKeys.length === 0) {
            showToast('No FGs to cancel', 'error');
            return;
        }
        
        let allSuccess = true;
        for (const fgKey of fgKeys) {
            const r = await API.cancelStage({ fgKey, targetStage: 'RM_ORDER' });
            if (!r.success) allSuccess = false;
        }
        if (allSuccess) {
            showToast('RM Order cancelled successfully', 'success');
            closeProcessPOModal();
            refreshRMOrders();
            refreshGRNOrders();
        } else {
            showToast('Some FGs could not be cancelled', 'warning');
        }
    } catch (e) {
        showToast('Error: ' + e.message, 'error');
    }
}

// ==============================================================
// FIXED NAVIGATION - Left Panel
// ==============================================================

// Navigation click handler for left panel
document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', function() {
        const module = this.dataset.module;
        
        // Update nav items
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        this.classList.add('active');
        
        // Update module content
        document.querySelectorAll('.module-content').forEach(c => c.classList.remove('active'));
        const el = document.getElementById(`module-${module}`);
        if (el) el.classList.add('active');
        
        // Load module data
        if (module === 'BUYER_ORDER') { 
            loadBuyers(); 
            setDefaultDates(); 
            generateAutoSerial(); 
            document.getElementById('gridSection').style.display = 'none'; 
        } else if (module === 'BOM') {
            refreshBOMOrders();
        } else if (module === 'RM_ORDER') {
            refreshRMOrders();
        } else if (module === 'GRN') {
            refreshGRNOrders();
        } else if (module === 'ISSUE_RM') {
            refreshIssueRMOrders();
        } else if (module === 'REPORTS') {
            loadReports();
        }
    });
});

// Ensure BUYER_ORDER loads on page load
document.addEventListener('DOMContentLoaded', function() {
    // Load theme
    loadTheme();
    
    // Load default module
    loadBuyers();
    setDefaultDates();
    generateAutoSerial();
    
    // Set active module
    const activeNav = document.querySelector('.nav-item.active');
    if (activeNav) {
        const module = activeNav.dataset.module;
        document.querySelectorAll('.module-content').forEach(c => c.classList.remove('active'));
        const el = document.getElementById(`module-${module}`);
        if (el) el.classList.add('active');
    }
    
    console.log('✅ Sneha Creations ERP v1.0 - Navigation Fixed');
});

// ==============================================================
// FIXED THEME TOGGLE
// ==============================================================

function toggleTheme() {
    const html = document.documentElement;
    const icon = document.getElementById('themeIcon');
    const currentTheme = html.getAttribute('data-theme');
    
    if (currentTheme === 'dark') {
        html.removeAttribute('data-theme');
        if (icon) icon.className = 'fas fa-moon';
        localStorage.setItem('theme', 'light');
    } else {
        html.setAttribute('data-theme', 'dark');
        if (icon) icon.className = 'fas fa-sun';
        localStorage.setItem('theme', 'dark');
    }
}

function loadTheme() {
    const savedTheme = localStorage.getItem('theme');
    const html = document.documentElement;
    const icon = document.getElementById('themeIcon');
    
    if (savedTheme === 'dark') {
        html.setAttribute('data-theme', 'dark');
        if (icon) icon.className = 'fas fa-sun';
    } else {
        html.removeAttribute('data-theme');
        if (icon) icon.className = 'fas fa-moon';
    }
}

// Call loadTheme on page load
document.addEventListener('DOMContentLoaded', function() {
    loadTheme();
});
