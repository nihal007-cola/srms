        const reqStatus = o.requirementStatus || 'PENDING';
        const bomStatus = o.bomStatus || 'PENDING';
        const fgKey = o.fgKey || '—';
        
        // Check if cancelled
        const isCancelled = bomStatus === 'CANCELLED' || reqStatus === 'CANCELLED';
        
        let statusBadge = 'info';
        let statusText = reqStatus;
        if (isCancelled) {
            statusBadge = 'danger';
            statusText = 'CANCELLED';
